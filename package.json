{
  "name": "yomikura",
  "private": true,
  "version": "1.0.25-beta.1",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc -b",
    "test": "vitest run src --configLoader native",
    "test:e2e": "playwright test",
    "verify-desktop": "pwsh -NoProfile -File scripts/verify-desktop.ps1",
    "check:bundle": "node scripts/check-build-budget.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:tag": "node scripts/check-release-tag.mjs",
    "check:suwayomi": "node scripts/check-suwayomi-upstream.mjs",
    "verify:release": "pnpm run check:version && pnpm run typecheck && pnpm test && pnpm run build && pnpm run check:bundle",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/plugin-fs": "~2.6.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@graphql-codegen/add": "^7.1.0",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
