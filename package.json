    "@tauri-apps/plugin-updater": "~2.10.1",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.0.0",
