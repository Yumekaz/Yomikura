{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yomikura",
  "version": "0.1.3",
  "identifier": "app.yomikura",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Yomikura",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMzU5MThBRkM4N0Q0NkIKUldScjFJZjhpcEUxajRQN1E4djJPa2JudnBEMUhMdzFmakx3eCs3QmNiTVdNbytJY1IvZUMyZkoK",
      "endpoints": [
        "https://github.com/Yumekaz/Yomikura/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../suwayomi-server/Suwayomi-Server-v2.2.2100.jar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
